# Local SQLite file. Swap for a Turso/libSQL remote URL in production:
# DATABASE_URL="libsql://your-db.turso.io"
DATABASE_URL="file:./local.db"
# Admin credentials, used only by npm run db:seed:admin.
# Never commit a real password; api/.env.local is gitignored.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
