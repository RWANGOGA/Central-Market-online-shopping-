{
  "name": "grocery-api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "npm run db:seed:products && npm run db:seed:geo && npm run db:seed:stock && npm run db:seed:products:phase3 && npm run db:seed:admin",
    "db:reset": "rm -f local.db && npm run db:push && npm run db:seed:products && npm run db:seed:geo && npm run db:seed:stock && npm run db:seed:products:phase3",
    "db:seed:geo": "tsx src/db/seed-geo.ts",
    "db:seed:products": "tsx src/db/seed.ts",
    "db:seed:admin": "tsx src/db/seed-admin.ts",
    "db:backfill:orders": "tsx src/db/backfill-orders.ts",
    "db:seed:stock": "tsx src/db/seed-stock-ledger.ts",
    "db:seed:products:phase3": "tsx src/db/seed-products-phase3.ts"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.3",
    "next": "15.5.27",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
